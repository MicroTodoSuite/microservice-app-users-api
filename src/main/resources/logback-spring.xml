<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="users-api"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level service=${serviceName} correlationId=%X{correlationId} traceId=%X{traceId} spanId=%X{spanId} logger=%logger{36} - %msg%n"/>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>
